# PaseRevista — .gitignore
# Higiene: nunca se suben secretos, credenciales ni datos clínicos.

# Gradle
.gradle/
build/
**/build/

# Wrapper (se conserva el .jar y .properties; no los dists descargados)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
local.properties

# Salida de APK/AAB generados (no subir binarios)
app/release/

# Keystore y firmas (JAMÁS subir)
*.jks
*.keystore
*.p12
keystore.properties

# Datos clínicos / bases de datos locales
*.db
*.db-shm
*.db-wal
schemas/

# Volcados de memoria de la JVM (Gradle): se generan al quedarse sin memoria
*.hprof

# Sistema
.DS_Store
Thumbs.db
