<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PaseRevista es 100% offline: sin permiso de INTERNET en v1. -->

    <!-- Respaldo local: en Android < 10 la carpeta pública necesita este permiso. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".PaseRevistaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaseRevista"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PaseRevista">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Widget: lista de camas del día con botón Compartir. -->
        <receiver
            android:name=".widget.CaseWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/case_widget_info" />
        </receiver>

        <service
            android:name=".widget.CaseWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Transparente: el widget la usa para lanzar el Sharesheet. -->
        <activity
            android:name=".widget.ShareDispatcherActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Widget 2: "Guardia rápida" estilo Todoist (check de un toque + entrada rápida). -->
        <receiver
            android:name=".widget.QuickWidgetProvider"
            android:exported="false"
            android:label="Guardia rápida">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>

        <service
            android:name=".widget.QuickWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Toques de las filas del widget rápido (check / detalle). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Overlays translúcidos de entrada rápida y detalle rápido. -->
        <activity
            android:name=".widget.QuickAddActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />
        <activity
            android:name=".widget.QuickDetailActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- Respaldo local: compartir el .db en Android < 10 (FileProvider). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
