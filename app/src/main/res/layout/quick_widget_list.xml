<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/quick_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/quick_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#1A73E8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dictar tarjeta" />

        <ImageButton
            android:id="@+id/quick_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="#1A73E8"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Añadir tarjeta" />
    </LinearLayout>

    <ListView
        android:id="@+id/quick_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/quick_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:text="Sin camas hoy — toca ＋ para añadir" />
</LinearLayout>
